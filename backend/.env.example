# Copy to .env and fill in your values. Do not commit .env.

# Core Django
DEBUG=False
DJANGO_SECRET_KEY=change-this-in-production
ALLOWED_HOSTS=.up.railway.app,localhost,127.0.0.1

# Database — PostgreSQL (recommended)
#
# Railway (backend service variables):
#   Prefer linking Postgres to this service (DATABASE_URL is injected automatically), OR
#   Variables → Add Variable Reference → your Postgres service → choose ONE of:
#     DATABASE_URL   — private URL; use this for Django on Railway (recommended).
#     You do NOT need PGHOST, PGUSER, DATABASE_PUBLIC_URL, etc. if DATABASE_URL is set.
#   DATABASE_PUBLIC_URL — only if you must connect from outside Railway (local pgAdmin, psql).
#   PGDATA, SSL_CERT_DAYS, RAILWAY_DEPLOYMENT_DRAINING_SECONDS — not used by Django; ignore for the app.
#
# Local: install Postgres and set one of the options below.
#
# Option A — single URL (matches Railway; use for local too):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
#
# Option B — discrete variables (handy for local .env without building a URL):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=your_db_name
# POSTGRES_USER=your_user
# POSTGRES_PASSWORD=your_password
#
# Optional: set USE_SQLITE=true only if you must run against SQLite instead of Postgres.
# USE_SQLITE=true

# Frontend domains for browser calls
# Comma-separated values, no spaces. Use your frontend Railway URL (no trailing slash).
# Example: https://reasonable-reprieve-production.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend.up.railway.app

# Email (Gmail: use App Password from https://myaccount.google.com/apppasswords)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# Cloudinary (media storage for product/category images on Railway)
# USE_CLOUDINARY=true
# Preferred single var:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or equivalent split vars:
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Optional overrides
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# ADMIN_EMAIL=admin@example.com

# Admin superuser bootstrap (set CREATE=true to auto-create/update admin at app startup)
# DJANGO_SUPERUSER_CREATE=true
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-this-password
# DJANGO_SUPERUSER_USERNAME=admin
